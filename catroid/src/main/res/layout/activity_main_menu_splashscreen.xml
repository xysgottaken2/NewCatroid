<!--
  Splash screen of an exported APK (`FEATURE_APK_GENERATOR_ENABLED`).
  It used to be an empty LinearLayout on a black window background, so every
  second of startup - and every failure - looked like a frozen black screen.
  Keep this layout free of anything that can throw: it is the first view the
  exported app shows.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/standalone_splash_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:gravity="center"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/standalone_splash_logo"
        android:layout_width="128dp"
        android:layout_height="128dp"
        android:contentDescription="@string/app_name"
        android:src="@mipmap/ic_launcher"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/standalone_splash_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/app_name"
        android:textColor="@color/solid_white"
        android:textSize="22sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/standalone_splash_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/accent" />

    <TextView
        android:id="@+id/standalone_splash_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/standalone_splash_loading"
        android:textColor="@color/accent"
        android:textSize="14sp" />

</LinearLayout>
